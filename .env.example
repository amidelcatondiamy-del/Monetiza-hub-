# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Angola PSP / EMIS Multicaixa Express Server Credentials (Server-Side Only)
# Configure these variables in your environment / Secrets panel to enable
# real Multicaixa Express charges & bank/Express payouts via server.ts.
# ---------------------------------------------------------------------------
# Provider preset: "appypay" | "proxypay" | "emis_gpo" | "custom"
ANGOLA_PSP_PROVIDER="appypay"

# Mode: "sandbox" | "live"
ANGOLA_PSP_MODE="sandbox"

# Base API URL for the Angolan PSP (e.g. AppyPay / ProxyPay / EMIS GPO)
ANGOLA_PSP_API_BASE_URL=""

# Optional OAuth2 token URL (e.g. AppyPay Microsoft/OAuth2 client_credentials endpoint)
ANGOLA_PSP_OAUTH_TOKEN_URL=""
ANGOLA_PSP_CLIENT_ID=""
ANGOLA_PSP_CLIENT_SECRET=""

# Direct API Key / Bearer token if the chosen PSP uses static API keys (e.g. ProxyPay / custom gateway)
ANGOLA_PSP_API_KEY=""

# Merchant / Entity / Terminal ID provided by EMIS or your Angolan PSP
ANGOLA_PSP_MERCHANT_ID=""

# Optional dedicated payout / transfer endpoint URL (if different from ANGOLA_PSP_API_BASE_URL/payouts)
ANGOLA_PSP_PAYOUT_ENDPOINT=""

# Webhook HMAC-SHA256 secret for verifying asynchronous PSP settlement callbacks
ANGOLA_PSP_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Brazil Payment Gateway Server Credentials (Pix, Boleto, Cartão Nacional)
# Configure these variables in your environment / Secrets panel to enable
# server-side integration with your chosen Brazilian gateway.
# ---------------------------------------------------------------------------
# Provider preset: "mercadopago" | "asaas" | "pagarme" | "efi" | "stripe_br" | "custom_br"
BR_GATEWAY_PROVIDER="mercadopago"

# Mode: "sandbox" | "live"
BR_GATEWAY_MODE="sandbox"

# Base API URL (required for custom_br; optional override for presets)
BR_GATEWAY_API_BASE_URL=""

# Server-side Secret Token / API Key (e.g. Mercado Pago Access Token, Asaas API Key, Pagar.me Secret Key)
BR_GATEWAY_ACCESS_TOKEN=""
BR_GATEWAY_API_KEY=""

# Optional OAuth2 Client Credentials (e.g. Efí Bank / Gerencianet Client ID + Client Secret)
BR_GATEWAY_CLIENT_ID=""
BR_GATEWAY_CLIENT_SECRET=""

# Public Merchant / Seller / Collector Account ID
BR_GATEWAY_MERCHANT_ID=""

# Webhook HMAC-SHA256 secret for verifying Pix, Boleto, and Card callbacks
BR_GATEWAY_WEBHOOK_SECRET=""

